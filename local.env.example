# Copy to local.env and fill in. bin/run_1872.sh reads it; local.env is never committed.
GPU_HOST=user@gpu-host              # ssh target of the GPU host running the laya-batch app and Ollama
GPU_SSH_KEY=$HOME/.ssh/gpu_host      # ssh key for GPU_HOST
GATEWAY_URL=https://llm-gateway      # OpenAI-compatible gateway in front of Ollama (Gemma labeler)
KEYCHAIN_SERVICE=gateway-key         # macOS keychain item holding the gateway client key
KEYCHAIN_ACCOUNT=client
